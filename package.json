{
  "name": "avend-asesor",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS AVEND ASESOR",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
