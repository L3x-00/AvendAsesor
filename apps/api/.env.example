# Server configuration
NODE_ENV=
PORT=

# Origin of the Next.js web application allowed to call the API.
WEB_ORIGIN=

# Supabase server integration. Never expose the service-role key to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local RAG worker. Enable only in the process assigned to ingestion.
RAG_INGESTION_WORKER_ENABLED=false
RAG_INGESTION_LEASE_SECONDS=300
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANSWER_MODEL=gpt-4o-mini
# Optional but required before enabling shared FAQ-memory aggregation. Generate
# a distinct server-only value of at least 32 characters; never expose it.
FAQ_MEMORY_FINGERPRINT_SECRET=
CHAT_HISTORY_LIMIT=20
OPENAI_API_KEY=
