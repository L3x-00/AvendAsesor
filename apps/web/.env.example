# URL pública del proyecto Supabase y clave publicable/anon. Nunca usar la service-role key aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL interna del backend NestJS. Nunca usar prefijo NEXT_PUBLIC: el navegador no debe llamar a la API administrativa directamente.
# En desarrollo local se usa http://localhost:3001.
ADMIN_API_URL=

# URL canónica de esta aplicación. En desarrollo se permite el fallback http://localhost:3000.
# En staging y producción debe ser HTTPS y debe estar autorizada en Supabase Auth Redirect URLs.
APP_URL=
