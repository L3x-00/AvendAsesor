# =============================================================================
# AvendAsesor — variables de entorno de ejemplo
# Copia este archivo a .env en cada app (apps/web/.env, apps/api/.env) y
# completa los valores reales. Nunca subas archivos .env con datos reales.
# =============================================================================

# =============================================================================
# WEB (apps/web)
# =============================================================================

# URL pública del proyecto Supabase y clave publicable/anon. Nunca usar la service-role key aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL interna del backend NestJS. Nunca usar prefijo NEXT_PUBLIC: el navegador no debe llamar a la API administrativa directamente.
# En desarrollo local se usa http://localhost:3001.
ADMIN_API_URL=

# URL canónica de esta aplicación. En desarrollo se permite el fallback http://localhost:3000.
# En staging y producción debe ser HTTPS y debe estar autorizada en Supabase Auth Redirect URLs.
APP_URL=

# =============================================================================
# API (apps/api)
# =============================================================================

# Server configuration
NODE_ENV=
PORT=

# Origin of the Next.js web application allowed to call the API.
WEB_ORIGIN=

# Supabase server integration. Never expose the service-role key to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
