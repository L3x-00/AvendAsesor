# =============================================================================
# AvendAsesor — variables de entorno de ejemplo
# Copia este archivo a .env en cada app (apps/web/.env, apps/api/.env) y
# completa los valores reales. Nunca subas archivos .env con datos reales.
# =============================================================================

# =============================================================================
# WEB (apps/web)
# =============================================================================

# URL pública del proyecto Supabase y clave publicable/anon. Nunca usar la service-role key aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del backend NestJS validada por el servidor. Nunca usar prefijo NEXT_PUBLIC:
# las páginas administrativas reciben solo el origen validado. El navegador llama
# directamente al API únicamente para transportar PDFs y evitar el límite de
# payload de Vercel; el API revalida el bearer, el rol y el contenido del archivo.
# En desarrollo local se usa http://localhost:3001.
ADMIN_API_URL=

# URL canónica de esta aplicación. En desarrollo se permite el fallback http://localhost:3000.
# En staging y producción debe ser HTTPS y debe estar autorizada en Supabase Auth Redirect URLs.
APP_URL=

# =============================================================================
# API (apps/api)
# =============================================================================

# Server configuration
NODE_ENV=
PORT=

# Origin of the Next.js web application allowed to call the API.
WEB_ORIGIN=

# Supabase server integration. Never expose the service-role key to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gateway de IA (RAG) ---
# Con OPENROUTER_API_KEY todo el trafico (embeddings y generacion) se enruta por
# OpenRouter como gateway unico; en su ausencia se usa OPENAI_API_KEY directo.
# AI_GATEWAY_BASE_URL sobreescribe el endpoint compatible con la API de OpenAI.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_BASE_URL=

# Modelos RAG (usar los nombres de OpenRouter cuando ese gateway este activo).
# Los embeddings DEBEN producir vectores de 1536 dimensiones (exigencia pgvector).
# Ej. prueba: RAG_ANSWER_MODEL=google/gemma-4-31b-it:free
# Ej. produccion: RAG_EMBEDDING_MODEL=openai/text-embedding-3-small ; RAG_ANSWER_MODEL=openai/gpt-5-mini
RAG_EMBEDDING_MODEL=
RAG_ANSWER_MODEL=
# Modelo pagado de respaldo; solo se activa ante error tecnico del primario.
RAG_ANSWER_FALLBACK_MODEL=

# Worker de ingesta RAG. Mantener en false hasta habilitar corpus real y proveedor.
RAG_INGESTION_WORKER_ENABLED=false
